<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 16:9 Standard Android TV Leanback Banner Background (320dp x 180dp) -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Centered Full Netflix Wordmark within TV Banner Safe Zone -->
    <item
        android:width="200dp"
        android:height="54dp"
        android:drawable="@drawable/ic_netflix_logo"
        android:gravity="center" />
</layer-list>
